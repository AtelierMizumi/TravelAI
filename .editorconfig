# EditorConfig is awesome: https://EditorConfig.org

# Top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file, utf-8 charset
[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

# Python & Java: 4 spaces indentation
[*.{py,java}]
indent_style = space
indent_size = 4
max_line_length = 100

# JavaScript, TypeScript, React, HTML, CSS, JSON, YAML: 2 spaces indentation
[*.{js,jsx,ts,tsx,html,css,scss,json,yaml,yml}]
indent_style = space
indent_size = 2

# Dockerfile & shell scripts
[*.{sh,bash,zsh,Dockerfile}]
indent_style = space
indent_size = 2

# Markdown: preserve trailing whitespace for linebreaks
[*.md]
trim_trailing_whitespace = false
indent_style = space
indent_size = 2
