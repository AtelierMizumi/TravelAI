# ==============================================================================
# TravelAI Platform - Environment Variables Template
# Copy this file to .env and configure appropriately: cp .env.example .env
# ==============================================================================

# --- Database Subsystem (PostgreSQL 16) ---
POSTGRES_DB=travelai_db
POSTGRES_USER=travelai_admin
POSTGRES_PASSWORD=your-db-password-here
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# --- AI Microservice (FastAPI + Google Cloud Vision) ---
AI_SERVICE_PORT=8001
AI_ENV=development
AI_MAX_FILE_SIZE_MB=10
AI_ALLOWED_EXTENSIONS=jpg,jpeg,png,webp
# Path to Google Service Account JSON (place in services/ai/credentials/ or root)
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json
GCP_PROJECT_ID=travelai-platform-dev

# --- Core Business Backend (Spring Boot 3 + Java 17) ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
DB_HOST=postgres
DB_PORT=5432
DB_NAME=travelai_db
DB_USER=travelai_admin
DB_PASSWORD=your-db-password-here
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
AI_SERVICE_URL=http://ai-service:8001

# --- Frontend Client (React 18 + Vite) ---
VITE_APP_TITLE=TravelAI Platform
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_AI_SERVICE_URL=http://localhost:8001/api/v1

# --- TravelAI 2.0 stack (docker compose --profile v2) ---
# Absolute host paths; the files stay outside the repository and are mounted read-only.
# e.g. HOST_GCP_KEY=/home/you/secrets/service-account.json
HOST_GCP_KEY=
# e.g. HOST_MESSAGE_KEY=/home/you/.local/share/travelai/message.key
HOST_MESSAGE_KEY=
# Bind v2 ports to all interfaces (phone over Wi-Fi). Default is loopback only.
# V2_BIND_ADDR=0.0.0.0
# Optional: Gemini chat; leave empty to disable.
GEMINI_API_KEY=

# --- Production edge (scripts/up.sh) ---
# POSTGRES_PASSWORD and HOST_MESSAGE_KEY are generated by scripts/gen-secrets.sh.
PUBLIC_ORIGIN=https://your-domain.example
HOST_GCP_KEY=/absolute/path/to/service-account.json
CLOUDFLARE_TUNNEL_TOKEN=replace-with-token-from-cloudflare-dashboard
