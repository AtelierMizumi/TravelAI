# ==============================================================================
# TravelAI Platform - Environment Variables Template
# Copy this file to .env and configure appropriately: cp .env.example .env
# ==============================================================================

# --- Database Subsystem (PostgreSQL 16) ---
POSTGRES_DB=travelai_db
POSTGRES_USER=travelai_admin
POSTGRES_PASSWORD=travelai_secure_password_2026
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# --- AI Microservice (FastAPI + Google Cloud Vision) ---
AI_SERVICE_PORT=8001
AI_ENV=development
AI_MAX_FILE_SIZE_MB=10
AI_ALLOWED_EXTENSIONS=jpg,jpeg,png,webp
# Path to Google Service Account JSON (place in services/ai/credentials/ or root)
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json
GCP_PROJECT_ID=travelai-platform-dev

# --- Core Business Backend (Spring Boot 3 + Java 17) ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
DB_HOST=postgres
DB_PORT=5432
DB_NAME=travelai_db
DB_USER=travelai_admin
DB_PASSWORD=travelai_secure_password_2026
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
AI_SERVICE_URL=http://ai-service:8001

# --- Frontend Client (React 18 + Vite) ---
VITE_APP_TITLE=TravelAI Platform
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_AI_SERVICE_URL=http://localhost:8001/api/v1
