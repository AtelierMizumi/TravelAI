# ==============================================================================
# TravelAI - environment template. Copy to .env: cp .env.example .env
# scripts/gen-secrets.sh generates the secrets for the production edge.
# ==============================================================================

# --- Database (PostgreSQL 16) ---
POSTGRES_PASSWORD=your-db-password-here

# --- Secrets mounted read-only into the containers (absolute host paths, outside the repo) ---
# Google Cloud Vision service-account JSON, e.g. /home/you/secrets/service-account.json
HOST_GCP_KEY=
# Message encryption key file, e.g. /home/you/.local/share/travelai/message.key
HOST_MESSAGE_KEY=

# --- Optional ---
# Bind the service ports to all interfaces (phone over Wi-Fi). Default is loopback only.
# V2_BIND_ADDR=0.0.0.0
# Gemini assistant chat; leave empty to disable.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Password-reset email. Resend SMTP: the password is a Resend API key (keep it only in the server .env).
# The sender domain must be verified in Resend. Leave TRAVELAI_SMTP_PASSWORD empty to disable the feature.
# TRAVELAI_SMTP_HOST=smtp.resend.com
# TRAVELAI_SMTP_PORT=587
# TRAVELAI_SMTP_USERNAME=resend
TRAVELAI_SMTP_PASSWORD=
TRAVELAI_SMTP_FROM=TravelAI <no-reply@your-domain.example>
# Stable base64 key (32+ bytes) for reset codes; scripts/gen-secrets.sh creates it. Do not rotate casually.
TRAVELAI_RESET_SECRET=
# Optional local landmark model (not baked into the image). See docs/tich-hop-ai-dia-danh.md.
# LANDMARK_MODEL_PATH=/app/models/landmark_classifier.onnx

# --- Production edge (scripts/up.sh) ---
PUBLIC_ORIGIN=https://your-domain.example
CLOUDFLARE_TUNNEL_TOKEN=replace-with-token-from-cloudflare-dashboard
